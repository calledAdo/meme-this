# Copy to .env.local and fill in. Never commit .env.local.

# Deployed contract addresses (from contracts/script/Deploy.s.sol output)
NEXT_PUBLIC_ARENA_ADDRESS=
NEXT_PUBLIC_LOCKER_ADDRESS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safari / mobile wallet pairing. Public project ID from https://dashboard.reown.com.
# Allow your production domain (and localhost for development) in the project settings.
# Set before building; without it, only browser wallets, Coinbase and mobile app links are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Human Passport — https://developer.passport.xyz (API Keys + Scorer, threshold 20)
PASSPORT_API_KEY=
PASSPORT_SCORER_ID=
PASSPORT_THRESHOLD=20

# Pass signer: a fresh key used ONLY for signing verification passes (its address = ATTESTER in the deploy)
ATTESTER_PRIVATE_KEY=

# Optional RPC overrides
ARC_RPC_URL=https://rpc.mainnet.arc.io
BASE_RPC_URL=https://mainnet.base.org

# Block the arena was deployed at (speeds up event queries)
ARENA_FROM_BLOCK=0
